{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://raw.githubusercontent.com/devgitgud/awesome-agile-resources/main/docs/resources.schema.json",
  "title": "Awesome Agile Resources JSON Contract",
  "description": "Schema for generated resources.json consumed by Pointaro and other clients.",
  "type": "object",
  "additionalProperties": false,
  "required": ["version", "generatedAt", "count", "resources"],
  "properties": {
    "version": {
      "type": "string",
      "description": "Data contract version. Increment major for breaking changes.",
      "pattern": "^[0-9]+\\.[0-9]+$"
    },
    "generatedAt": {
      "type": "string",
      "description": "UTC date when resources.json was generated.",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    },
    "count": {
      "type": "integer",
      "description": "Number of resources in the resources array.",
      "minimum": 0
    },
    "resources": {
      "type": "array",
      "description": "Collection of resource records for listing/detail pages.",
      "items": {
        "$ref": "#/$defs/resource"
      }
    }
  },
  "$defs": {
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "title", "category", "website", "tags", "slug"],
      "properties": {
        "id": {
          "type": "string",
          "description": "Stable unique identifier independent of filename.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "title": {
          "type": "string",
          "description": "Display title for the resource.",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "description": "Top-level category used for filtering and route grouping.",
          "enum": [
            "Tools",
            "Books",
            "Courses",
            "Websites",
            "Templates",
            "Podcasts",
            "Videos",
            "Communities"
          ]
        },
        "subcategory": {
          "type": ["string", "null"],
          "description": "Optional secondary grouping under a category."
        },
        "website": {
          "type": "string",
          "description": "Canonical primary website URL.",
          "format": "uri",
          "pattern": "^https?://"
        },
        "tags": {
          "type": "array",
          "description": "Tags for search and filtering.",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "price": {
          "type": ["string", "null"],
          "description": "Pricing model label (for filtering)."
        },
        "featured": {
          "type": "boolean",
          "description": "Whether the resource should be highlighted."
        },
        "audience": {
          "type": "array",
          "description": "Target audience segments.",
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "difficulty": {
          "type": ["string", "null"],
          "description": "Relative learning curve for the resource."
        },
        "githubUrl": {
          "type": ["string", "null"],
          "description": "Optional GitHub project URL.",
          "format": "uri",
          "pattern": "^https?://"
        },
        "officialUrl": {
          "type": ["string", "null"],
          "description": "Optional official product/documentation URL.",
          "format": "uri",
          "pattern": "^https?://"
        },
        "pointaroRecommended": {
          "type": "boolean",
          "description": "Whether Pointaro should prioritize this resource in curated views."
        },
        "description": {
          "type": ["string", "null"],
          "description": "SEO-friendly summary or short description.",
          "minLength": 1
        },
        "status": {
          "type": ["string", "null"],
          "description": "Lifecycle status for the resource.",
          "enum": ["active", "archived", "deprecated", null]
        },
        "lastReviewed": {
          "type": ["string", "null"],
          "description": "Last review date in UTC calendar format.",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        },
        "slug": {
          "type": "string",
          "description": "URL-safe slug used for detail routes.",
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "file": {
          "type": "string",
          "description": "Path to source markdown file in repository.",
          "pattern": "^resources/.+\\.md$"
        }
      }
    }
  }
}
